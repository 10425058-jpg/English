# ==============================================================================
# English Quest — Environment Variables Example
# Copy to .env for local development. NEVER commit real credentials or API keys.
# ==============================================================================

# Frontend (Vite)
VITE_APP_NAME=English Quest
VITE_BASE_PATH=/English/
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Backend (NestJS — Phase 2+)
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english_quest?schema=public
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-in-production-min-32-chars

# AI & Audio Providers (Server-side ONLY — Phase 3+)
# Never prefix private AI provider keys with VITE_
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
STT_PROVIDER=browser-fallback
TTS_PROVIDER=browser-fallback
PRONUNCIATION_PROVIDER=none
AI_DAILY_TOKEN_BUDGET=50000
